            ожидаемый код в скрипте. Скопируйте ключ в переменную token.
          sortKey: -229404797
        method: POST
        body:
          mimeType: application/json
          text: |-
            {
              "login": "{{ _.login }}",
              "password": "{{ _.password }}",
              "companyId": "{{ _.company_id }}"
            }
        headers:
          - name: Accept
            value: application/json
          - name: Content-Type
            value: application/json
        scripts:
          afterResponse: |-
            insomnia.test("Successful key creation status", () => {
              insomnia.expect([200, 201]).to.include(insomnia.response.code);
            });

            insomnia.test("Response is JSON", () => {
              insomnia.expect(insomnia.response.text()).to.be.a("string");
              JSON.parse(insomnia.response.text());
            });
        settings:
          renderRequestBody: true
          encodeUrl: true
          followRedirects: global
          cookies:
            send: true
            store: true
          rebuildPath: true
